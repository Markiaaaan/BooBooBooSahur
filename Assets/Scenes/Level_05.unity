  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GameManager
  levelNumber: 5
  levelTitle: "\u0417\u0430\u043B\u0430 \u041A\u043B\u044E\u0447\u043D\u0438\u043A\u0430"
  levelHint: "\u041A\u043B\u044E\u0447 \u0443 \u041A\u043B\u044E\u0447\u043D\u0438\u043A\u0430. \u0423\u0434\u0430\u0440 \u0443 \u0434\u0437\u0432\u0456\u043D \u043F\u0456\u0434 \u0432\u0430\u043D\u0442\u0430\u0436\u0435\u043C, \u0430 \u043A\u043E\u043B\u0438 \u0432\u0456\u043D \u043F\u0440\u0438\u0439\u0434\u0435 - \u0442\u044F\u0433\u043D\u0438 \u043B\u0430\u043D\u0446\u044E\u0433. \u0422\u0440\u0438 \u0432\u043B\u0443\u0447\u0430\u043D\u043D\u044F, \u0456 \u043A\u043B\u044E\u0447 \u0442\u0432\u0456\u0439. \u041C\u0456\u0441\u044F\u0447\u043D\u0435 \u0441\u0432\u0456\u0442\u043B\u043E \u0442\u0435\u0431\u0435 \u0432\u0438\u043A\u0430\u0437\u0443\u0454!"
  nextTitle: "\u0424\u0406\u041D\u0410\u041B"
  nextName: "\u041D\u0430\u0433\u043E\u0440\u0443, \u0434\u043E \u043D\u0456\u0447\u043D\u043E\u0433\u043E \u043C\u0456\u0441\u0442\u0430"
  caughtDelay: 1.8
  restartInsteadOfNext: 0
